{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "localhost (Edge)",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://localhost:50859",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "localhost (Edge via Chrome adapter)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:50859",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe"
    }
  ]
}

