        "authLevel": "Anonymous",
        "methods": [
          "get",
          "post",
          "put",
          "delete"
        ],
        "route": "accounts/{id?}",
        "properties": {}
      },
      {
        "name": "$return",
        "type": "http",
        "direction": "Out"
      }
    ]
  },
