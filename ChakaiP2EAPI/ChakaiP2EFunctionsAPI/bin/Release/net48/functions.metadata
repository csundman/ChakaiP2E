[
  {
    "name": "AccountsCRUD",
    "scriptFile": "ChakaiP2EFunctionsAPI.exe",
    "entryPoint": "ChakaiP2EFunctionsAPI.Functions.AccountsController.Run",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "req",
        "direction": "In",
